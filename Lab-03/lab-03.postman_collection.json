    {
      "name": "04 order_by=price&order=DESC&limit=5",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/?order_by=price&order=DESC&limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            ""
          ],
          "query": [
            {
              "key": "order_by",
              "value": "price"
            },
            {
              "key": "order",
              "value": "DESC"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Returns 5 books sorted by price descending', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.length).to.eql(5);",
              "    for (var i = 0; i < jsonData.length - 1; i++) {",
              "        pm.expect(jsonData[i].price).to.be.at.least(jsonData[i + 1].price);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
